# ---- Python 编译产物 ----
__pycache__/
*.py[cod]
*$py.class

# ---- 虚拟环境 ----
.venv/
venv/

# ---- pytest ----
.pytest_cache/

# ---- 运行产物（日志 / 报告）----
logs/
reports/

# ---- 打包产物（pip install -e . 会生成 egg-info）----
*.egg-info/
build/
dist/

# ---- 本地工具（allure 命令行等，体积大，各人自己装）----
tools/

# ---- IDE / 本机配置 ----
.idea/
.mcp.json

# ---- 环境配置（含测试账号、库密码，不进库；模板见 config/config.example.yaml）----
config/config.yaml

# ---- 个人 / 学习材料（不进公开仓库）----
docs/课程项目借鉴.md
